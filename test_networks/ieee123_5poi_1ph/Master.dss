Clear

// New Circuit.ieee123_5poi_1ph  

// Edit "Vsource.source" bus1=1 pu=1.03 R0=0 X0=0.00000001 phases=1 basekv=2.4018 R1=0 X1=0.00000001

! 4.16 kV line-to-line (2.4018 kV line-to-neutral), the IEEE 123-node feeder's own voltage (user, 2026-11-03). From
! 2025-11-14 to 2026-11-03 this deck ran at 20 kV (11.547 kV LN) with the same 4.16 kV line impedances.
New Circuit.ieee123_5poi_1ph basekv=2.4018 Bus1=1s pu=1.05 R1=0 X1=0.0001 R0=0 X0=0.0001
VSource.source.enabled=false  //Disable the default VSource created when declaring the circuit.

! Every substation is an EMF (pu, angle) behind a source impedance Zs: the IEEE 123-node feeder's own substation
! transformer, 5000 kVA, 115 kV delta / 4.16 kV grounded wye, Z = 1 + j8 % (Kersting 2001 test feeder data):
! 0.01 + j0.08 x 4.16^2 / 5 = 0.0346 + j0.2769 ohm; the 115 kV grid behind it is taken as stiff. Each added
! substation (subs2-5) gets the same transformer. A 1-phase Vsource's impedance is (2 Z1 + Z0)/3, so Z1 and Z0
! are both set to it, which keeps Zs = Z1. (At 20 kV, 2026-09-28 to 2026-11-03: 0.032 + j0.799 ohm from a
! 0.50 GVA short-circuit level; before that stiff 1e-8 ohm stand-ins.)
New Vsource.subs1 Phases=1 Bus1=1s basekv=2.4018 pu=1.05 angle=0.0 R1=0.034611 X1=0.276890 R0=0.034611 X0=0.276890
New Vsource.subs2 Phases=1 Bus1=2s basekv=2.4018 pu=1.05 angle=0.0 R1=0.034611 X1=0.276890 R0=0.034611 X0=0.276890
New Vsource.subs3 Phases=1 Bus1=3s basekv=2.4018 pu=1.05 angle=0.0 R1=0.034611 X1=0.276890 R0=0.034611 X0=0.276890
New Vsource.subs4 Phases=1 Bus1=4s basekv=2.4018 pu=1.05 angle=0.0 R1=0.034611 X1=0.276890 R0=0.034611 X0=0.276890
New Vsource.subs5 Phases=1 Bus1=5s basekv=2.4018 pu=1.05 angle=0.0 R1=0.034611 X1=0.276890 R0=0.034611 X0=0.276890

Redirect BranchData.dss

! POI connection lines from substations to distribution buses
New Line.poi1 Phases=1 Bus1=1s Bus2=1 r1=1e-06 x1=1e-06
New Line.poi2 Phases=1 Bus1=2s Bus2=33 r1=1e-06 x1=1e-06
New Line.poi3 Phases=1 Bus1=3s Bus2=120 r1=1e-06 x1=1e-06
New Line.poi4 Phases=1 Bus1=4s Bus2=116 r1=1e-06 x1=1e-06
New Line.poi5 Phases=1 Bus1=5s Bus2=85 r1=1e-06 x1=1e-06

Redirect ../LoadShapeDefault.dss
Redirect ../LoadShapePVDefault.dss
Redirect Loads.dss     ! Balanced Loads
// Redirect  Capacitor.dss
Redirect PVSystem.dss
Redirect Storage.dss

Set VoltageBases = [4.16]
Set mode = Daily 
Set stepsize = 1h
Set number = 1

! Let DSS estimate the voltage bases
CalcVoltageBases     ! This also establishes the bus list
