Clear
! epri_ckt24_1ph: single-phase per-phase equivalent of test_systems\epri_test_circuits\ckt24\master_ckt24.dss (unmodified original).
! Written by envs/multi_poi/root_level/convert_to_1ph.jl -- do not edit by hand.
New Circuit.epri_ckt24_1ph basekv=19.9186 Bus1=s1 pu=1.05 phases=1 R1=0 X1=0.0001 R0=0 X0=0.0001
VSource.source.enabled=false  //Disable the default VSource created when declaring the circuit.
! Each substation is an EMF behind its transformer into the MV network (parallel units combined), in ohm at
! 34.5 kV. A 1-phase Vsource's impedance is (2 Z1 + Z0)/3, so Z1 = Z0 = Zs.
New Vsource.subs1 Phases=1 Bus1=s1 basekv=19.9186 pu=1.05 angle=0.0 R1=0.06348 X1=2.81164 R0=0.06348 X0=2.81164
Redirect BranchData.dss
Redirect Ties.dss
! Substation connection lines
New Line.poi1 Phases=1 Bus1=s1 Bus2=subxfmr_lsb.1 r1=1e-06 x1=1e-06
Redirect ../LoadShapeDefault.dss
Redirect ../LoadShapePVDefault.dss
Redirect Loads.dss     ! Balanced Loads
// Redirect  Capacitor.dss
Redirect PVSystem.dss
Redirect Storage.dss

Set VoltageBases = [34.5]
Set mode = Daily
Set stepsize = 1h
Set number = 1

CalcVoltageBases
