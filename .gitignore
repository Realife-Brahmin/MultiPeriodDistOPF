# Julia resolved manifests are ignored by default, with one deliberate exception:
# envs/tadmm/Manifest.toml is tracked so that the published results reproduce
# against the exact package versions they were produced with. Do not untrack it.
**/Manifest.toml
!envs/tadmm/Manifest.toml

# Generated experiment outputs.
# Regenerated locally by envs/tadmm/root_level/{run_bf,run_tadmm,run_rho_sweep}.jl.
# The curated final-winner subset is tracked under results/ instead.
envs/*/processedData/

# Upstream clone of the authors' FilterDDP.jl, checked out under ddp/external/
# for the FilterDDP evaluation. It carries its own .git, so tracking it here
# would create an embedded repository.
ddp/external/

# Third-party papers fetched from arXiv for the FilterDDP evaluation, and their
# text extractions. Not ours to redistribute from a public repo; re-fetch with
# the commands in ddp/README_FILTERDDP_EXPERIMENT.md.
ddp/papers/

# Local review / scratch artifacts (not part of the repo)
logs/
tmp/
# ...except the FilterDDP evaluation's logs, which are its evidence: the status
# table in ddp/README_FILTERDDP_EXPERIMENT.md links to them.
!ddp/logs/
pngs_review/
gks*.png

# LaTeX build artifacts
**/tex/*.aux
**/tex/*.fdb_latexmk
**/tex/*.fls
**/tex/*.log
**/tex/*.synctex.gz

# Intermediate data-conversion outputs (only final systems kept in rawData/)
rawData/flexparams_10k_1ph/

# Python bytecode
__pycache__/
*.pyc

# Assistant session notes -- local working material, not part of the repo
.claude/
