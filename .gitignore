# Julia resolved manifests (reproduced via `Pkg.instantiate()`)
**/Manifest.toml

# Generated experiment outputs.
# Regenerated locally by run_bf.jl / run_tadmm.jl / run_rho_sweep.jl.
# The curated final-winner subset is tracked under results/ instead.
envs/*/processedData/

# Local review / scratch artifacts (not part of the repo)
logs/
pngs_review/
gks*.png

# LaTeX build artifacts
**/tex/*.aux
**/tex/*.fdb_latexmk
**/tex/*.fls
**/tex/*.log
**/tex/*.synctex.gz

# Intermediate data-conversion outputs (only final systems kept in rawData/)
rawData/flexparams_10k_1ph/

# Python bytecode
__pycache__/
*.pyc
